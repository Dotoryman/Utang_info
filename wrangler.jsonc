{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "utang-info",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utangland-db",
      "database_id": "23ef9f9a-b39d-4efb-a916-5185e2be733e",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "utangland-profile-images"
    }
  ],

  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "9001001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "REGISTER_RATE_LIMITER",
      "namespace_id": "9001002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
